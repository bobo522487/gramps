# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
# Required: at least 32 characters. Rotating it invalidates every session.
BETTER_AUTH_SECRET=***
# Required: absolute public URL of the app.
BETTER_AUTH_URL=http://localhost:3000
# Optional: debug | info | warn | error (defaults to debug in development, info in production).
LOG_LEVEL=info
# Production-only (required on Vercel): dedicated login roles.
# APP_POSTGRES_URL may use Neon's pooled endpoint.
# APP_POSTGRES_URL=postgresql://app:...@.../db
# AUTH_POSTGRES_URL must use Neon's direct (unpooled) endpoint: the auth
# connection pins role=auth_service with a startup parameter, which the
# pooler rejects.
# AUTH_POSTGRES_URL=postgresql://auth_runtime:...@.../db
# Optional: dedicated database for `pnpm test:integration`.
# The database name must end with `_test`; tests truncate every table.
# TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:54322/gramps_test
# Migration side (GitHub Actions secrets, not the app). `pnpm db:provision-roles`
# creates/updates the login roles before `db:migrate`; the password never lives
# in SQL. Neon rejects weak passwords, so use >=20 chars with mixed case, digits
# and symbols. Keep these in sync with APP_POSTGRES_URL / AUTH_POSTGRES_URL below.
# APP_DB_PASSWORD=***
# AUTH_DB_PASSWORD=***
# Direct (unpooled) endpoint used by `pnpm db:migrate` and the reset script.
# POSTGRES_URL_DIRECT=postgresql://...
# Alias of the direct endpoint read by drizzle.config.ts and the diagnose /
# provision / reset scripts when POSTGRES_URL_DIRECT is not set.
# POSTGRES_URL_NON_POOLING=postgresql://...
# Admin endpoint used only by `pnpm verify:target-schema` (it creates and
# drops its own scratch database). Never point this at a real environment.
# VERIFY_POSTGRES_URL=postgresql://...
# Legacy alias of APP_POSTGRES_URL read by verify-deployment.mjs as a fallback.
# APP_DATABASE_URL=postgresql://...
