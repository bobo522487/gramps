{
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:setup": "npx tsx lib/db/setup.ts",
    "db:seed": "npx tsx --conditions=react-server lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-target": "node scripts/reset-target-db.mjs",
    "db:provision-roles": "node scripts/provision-roles.mjs",
    "db:studio": "drizzle-kit studio",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "arch:check": "node scripts/check-file-size.mjs && node scripts/check-env-access.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "verify:target-schema": "node scripts/verify-target-schema.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "3.11.1",
    "@xyflow/react": "^12.12.1",
    "better-auth": "1.7.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postcss": "8.5.31",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "^0.31.11",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
